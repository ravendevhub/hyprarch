{
  // ===========================================================================
  // THEME & AESTHETICS (Modern Classic / Nordic Palette)
  // ===========================================================================
  "workbench.colorTheme": "Catppuccin Mocha",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.list.smoothScrolling": true,
  "workbench.startupEditor": "none",
  "window.titleBarStyle": "custom",
  "window.menuBarVisibility": "compact",
  "window.dialogStyle": "custom",
  "workbench.layoutControl.enabled": false,
  "workbench.tree.indent": 18,
  "workbench.tree.renderIndentGuides": "always",

  // ===========================================================================
  // TYPOGRAPHY & LIGATURES (JetBrains Mono Nerd Font)
  // ===========================================================================
  "editor.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrains Mono', 'Fira Code', monospace",
  "editor.fontLigatures": "'calt', 'liga', 'ss01', 'ss02', 'zero'",
  "editor.fontSize": 14,
  "editor.lineHeight": 1.65,
  "editor.letterSpacing": 0.3,
  "editor.fontWeight": "400",

  // ===========================================================================
  // SMOOTH ANIMATIONS & CARET RENDERING
  // ===========================================================================
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorStyle": "line",
  "editor.cursorWidth": 2,
  "editor.smoothScrolling": true,
  "editor.renderWhitespace": "selection",
  "editor.renderLineHighlight": "all",
  "editor.roundedSelection": true,
  "editor.matchBrackets": "always",

  // ===========================================================================
  // BRACKET PAIRS & INDENT GUIDES
  // ===========================================================================
  "editor.bracketPairColorization.enabled": true,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.guides.bracketPairs": "active",
  "editor.guides.bracketPairsHorizontal": true,
  "editor.guides.highlightActiveIndentation": true,
  "editor.guides.indentation": true,

  // ===========================================================================
  // CODE FORMATTING & CLEANLINESS
  // ===========================================================================
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.tabSize": 2,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  // ===========================================================================
  // MINIMAP & BREADCRUMBS
  // ===========================================================================
  "editor.minimap.enabled": false,
  "breadcrumbs.enabled": true,

  // ===========================================================================
  // PRODUCTIVITY & AUTO-COMPLETE
  // ===========================================================================
  "editor.inlineSuggest.enabled": true,
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": true,
  },
  "editor.suggestSelection": "first",
  "editor.acceptSuggestionOnEnter": "on",
  "editor.snippetSuggestions": "top",

  // ===========================================================================
  // INTEGRATED TERMINAL (Translucent & JetBrains Mono)
  // ===========================================================================
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font'",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.lineHeight": 1.4,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorWidth": 2,
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.copyOnSelection": true,

  // ===========================================================================
  // EXTENSION SPECIFIC POLISH
  // ===========================================================================
  "errorLens.enabled": true,
  "errorLens.fontStyleItalic": true,
  "errorLens.fontSize": "12px",
  "material-icon-theme.activeIconPack": "react",
  "material-icon-theme.folders.theme": "classic",
  "catppuccin.accentColor": "sky",
  "python.languageServer": "Default",
}
